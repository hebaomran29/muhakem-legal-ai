# عنوان الباك إند (FastAPI) — لو فاضي، الموقع بيشتغل بـ mock بيانات
VITE_API_BASE_URL=http://localhost:8000

# من Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# من نفس الصفحة → API Keys → Publishable key (آمن يتحط في الفرونت،
# مش سري زي service key أو JWT secret)
VITE_SUPABASE_ANON_KEY=
