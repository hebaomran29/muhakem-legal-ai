+
+جاوبي بإيجاز ودقة، واذكري المرجع المحدد (رقم الطعن أو المادة) لو موجود:"""
+
+    return pipeline.llm_text([{"role": "user", "content": prompt}],
+                              temperature=0.1, max_tokens=600)
