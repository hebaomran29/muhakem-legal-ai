# ── موجودين من الأول ──────────────────────────────────────────
OPENROUTER_KEY=
QDRANT_URL=
QDRANT_API_KEY=
CORS_ORIGINS=*

# ── جديد: الداتابيز (Supabase) ────────────────────────────────
# من Supabase Dashboard → Project Settings → Database → Connection string (URI)
# استخدمي الـ "Connection pooling" string (وضع Transaction) لو هتنشري على سيرفر
# فيه أكتر من instance، أو الـ direct connection وانتي بتجربي محليًا.
SUPABASE_DB_URL=

# من Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=

# ملحوظة: لو السطرين دول فاضيين، الموقع هيفضل شغال بالظبط زي الأول
# (بدون تسجيل دخول، بدون حفظ دائم) — إضافة الداتابيز اختيارية ومتدرّجة.
